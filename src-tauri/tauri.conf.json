{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Status Board",
  "version": "0.1.7",
  "identifier": "com.lingrui.llmstatusboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Status Board",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
