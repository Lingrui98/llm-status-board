{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Status Board",
  "version": "0.2.9",
  "identifier": "com.lingrui.llmstatusboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Status Board",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "summary",
        "title": "用量总结",
        "url": "summary.html",
        "width": 300,
        "height": 360,
        "minWidth": 260,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNzhDQzdGRDkwOUZERkYKUldULy9RblpmOHg0SXFQWWs3SjhPUlVFRUF1dDBReWsvMll6TWZRQWtrSHdKZkwwN1ljNjUyeG4K",
      "endpoints": [
        "https://github.com/Lingrui98/llm-status-board/releases/latest/download/latest.json"
      ]
    }
  }
}
